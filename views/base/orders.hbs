<main>
  <section class="page-hero">
    <div class="container">
      <h1>My Orders</h1>
      <p>Track and manage your orders</p>
    </div>
  </section>

  <section class="py-4">
    <div class="container">
      {{#if orders.length}}
      <div class="row">
        {{#each orders}}
        <div class="col-12 mb-3">
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong>Order #{{this._id}}</strong>
                  <span class="badge bg-{{#ifCond this.status 'delivered'}}success{{else ifCond this.status 'cancelled'}}danger{{else}}warning{{/ifCond}} ms-2">{{this.status}}</span>
                  <span class="badge bg-info ms-1 text-uppercase">{{this.paymentMethod}}</span>
                </div>
                <div class="text-end">
                  <strong class="fs-5"><i class="fas fa-rupee-sign"></i> {{this.grandTotal}}</strong>
                  {{#if this.offerDiscount}}
                  <br><small class="text-success">Saved ₹{{this.offerDiscount}}</small>
                  {{/if}}
                </div>
              </div>
              <p class="mb-0 text-muted small mt-1">{{this.createdAt}}</p>
              {{#if this.items.length}}
              <div class="mt-2 small text-muted">
                {{#each this.items}}
                <span class="me-2">{{this.orderItemId.productName}} x{{this.orderItemId.quantity}}</span>
                {{/each}}
              </div>
              {{/if}}
              <div class="mt-2 d-flex gap-2">
                {{#ifCond this.status "placed"}}
                <button class="btn btn-sm btn-outline-danger cancel-order" data-order-id="{{this._id}}">
                  <i class="fas fa-times"></i> Cancel
                </button>
                {{/ifCond}}
                <a href="/orders/{{this._id}}/invoice" class="btn btn-sm btn-outline-success">
                  <i class="fas fa-download"></i> Invoice
                </a>
                <button class="btn btn-sm btn-outline-primary email-invoice" data-order-id="{{this._id}}">
                  <i class="fas fa-envelope"></i> Email
                </button>
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      <script>
        $(document).ready(function() {
          $('.cancel-order').on('click', function() {
            var orderId = $(this).data('order-id');
            Swal.fire({
              title: 'Cancel Order?',
              text: 'This action cannot be undone',
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#dc3545',
              confirmButtonText: 'Yes, cancel it'
            }).then((result) => {
              if (result.isConfirmed) {
                $.ajax({
                  url: '/orders/' + orderId + '/cancel',
                  method: 'PATCH',
                  success: function(resp) {
                    if (resp.status) {
                      Swal.fire('Cancelled', 'Order has been cancelled', 'success').then(function() {
                        location.reload();
                      });
                    }
                  },
                  error: function(xhr) {
                    var msg = 'Could not cancel order';
                    try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
                    Swal.fire('Error', msg, 'error');
                  }
                });
              }
            });
          });
          $('.email-invoice').on('click', function() {
            var orderId = $(this).data('order-id');
            Swal.fire({
              title: 'Email Invoice?',
              text: 'We will send the invoice to your registered email address.',
              icon: 'question',
              showCancelButton: true,
              confirmButtonColor: '#16a34a',
              confirmButtonText: 'Yes, send it'
            }).then((result) => {
              if (result.isConfirmed) {
                Swal.fire({ title: 'Sending...', text: 'Generating and sending invoice', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                $.ajax({
                  url: '/orders/' + orderId + '/invoice/email',
                  method: 'POST',
                  success: function(resp) {
                    if (resp.status) {
                      Swal.fire('Sent!', resp.message || 'Invoice sent to your email', 'success');
                    }
                  },
                  error: function(xhr) {
                    var msg = 'Could not send invoice';
                    try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
                    Swal.fire('Error', msg, 'error');
                  }
                });
              }
            });
          });
        });
      </script>
      {{else}}
      <div class="text-center py-5">
        <i class="fas fa-box-open" style="font-size:3rem;color:#ccc;"></i>
        <h4 class="mt-3">No orders yet</h4>
        <p class="text-muted">Start shopping to see your orders here.</p>
        <a href="/" class="btn btn-success">Shop Now</a>
      </div>
      {{/if}}
    </div>
  </section>
</main>
