<main>
  <section class="page-hero">
    <div class="container">
      <h1>My Orders</h1>
      <p>Track and manage your orders</p>
    </div>
  </section>

  <section class="py-4">
    <div class="container">
      {{#if orders.length}}
      <div class="row">
        {{#each orders}}
        <div class="col-12 mb-3">
          <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
              <div>
                <strong>Order #{{this._id}}</strong>
                <span class="badge bg-{{#ifCond this.status 'delivered'}}success{{else ifCond this.status 'cancelled'}}danger{{else}}warning{{/ifCond}} ms-2">{{this.status}}</span>
                <p class="mb-0 text-muted small">{{this.createdAt}}</p>
              </div>
              <div class="text-end">
                <strong><i class="fas fa-rupee-sign"></i> {{this.totalAmount}}</strong>
                <br>
                <span class="text-capitalize">{{this.paymentMethod}}</span>
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="text-center py-5">
        <i class="fas fa-box-open" style="font-size:3rem;color:#ccc;"></i>
        <h4 class="mt-3">No orders yet</h4>
        <p class="text-muted">Start shopping to see your orders here.</p>
        <a href="/" class="btn btn-success">Shop Now</a>
      </div>
      {{/if}}
    </div>
  </section>
</main>
