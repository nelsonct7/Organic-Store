<main>
  {{!-- Hero Section --}}
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <h1>Fresh &amp; Organic<br><span>Delivered to You</span></h1>
        <p>Farm-fresh fruits, vegetables and organic groceries delivered straight from the farm to your doorstep. 100% organic and chemical free.</p>
        <div class="hero-cta">
          <a href="#products" class="btn-primary-custom">
            Shop Now <i class="fas fa-arrow-right"></i>
          </a>
          <a href="/about-us" class="btn-outline-custom">
            Learn More <i class="fas fa-leaf"></i>
          </a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/assets/img/base/hero1.png" alt="Fresh Organic Produce" class="hero-img">
      </div>
    </div>
  </section>

  {{#if banners.length}}
  {{!-- Banner Carousel --}}
  <section class="banner-carousel-section">
    <div class="container">
      <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-indicators">
          {{#each banners}}
          <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="{{@index}}" class="{{#if @first}}active{{/if}}" aria-current="{{#if @first}}true{{/if}}" aria-label="Slide {{add @index 1}}"></button>
          {{/each}}
        </div>
        <div class="carousel-inner rounded-3 overflow-hidden">
          {{#each banners}}
          <div class="carousel-item {{#if @first}}active{{/if}}">
            <img src="/banner-images/{{this.imageUrl}}" class="d-block w-100" alt="{{this.title}}" style="height:400px;object-fit:contain;">
            <div class="carousel-caption d-none d-md-block">
              {{!-- <h3>{{this.title}}</h3> --}}
              {{#if this.link}}<a href="{{this.link}}" class="btn btn-light btn-sm mt-2">Shop Now</a>{{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if categories.length}}
  {{!-- Categories Section --}}
  <section class="categories-section">
    <div class="container">
      <div class="section-header">
        <h2>Shop by Category</h2>
        <p>Browse our wide range of organic products</p>
      </div>
      <div class="category-grid">
        {{#each categories}}
        <a href="/category/{{this._id}}" class="category-card">
          {{#if this.imageUrl}}
          <img src="/category-images/{{this.imageUrl}}" alt="{{this.name}}">
          {{else}}
          <div class="category-icon"><i class="fas fa-leaf"></i></div>
          {{/if}}
          <h3>{{this.name}}</h3>
        </a>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  {{#if products.length}}
  {{!-- Products Section --}}
  <section class="products-section" id="products">
    <div class="container">
      <div class="section-header">
        <h2>Fresh Organic Produce</h2>
        <p>Handpicked and delivered fresh from the farm</p>
      </div>
      <div class="product-grid">
        {{#each products}}
        <div class="product-card">
          <div class="card-img-wrap">
            <a href="/view-product/{{this._id}}" class="card-img">
              {{#if this.images.length}}
              <img src="/product-images/{{this.images.[0].url}}" alt="{{this.name}}">
              {{else}}
              <i class="fas fa-image" style="font-size:2rem;color:#ccc;"></i>
              {{/if}}
            </a>
            {{#if this.bestOffer}}
            <span class="card-badge">
              {{#ifCond this.bestOffer.type "percentage"}}{{this.bestOffer.value}}% OFF{{/ifCond}}
              {{#ifCond this.bestOffer.type "fixed"}}₹{{this.bestOffer.value}} OFF{{/ifCond}}
            </span>
            {{/if}}
            <button class="btn-add-cart-quick" onclick="addToCart('{{this._id}}')" title="Add to cart">
              <i class="fas fa-shopping-cart"></i>
            </button>
          </div>
          <div class="card-body">
            <h3><a href="/view-product/{{this._id}}">{{this.name}}</a></h3>
            <div class="card-price">
              {{#if this.bestOffer}}
              <span class="original"><i class="fas fa-rupee-sign"></i> {{this.price}}</span>
              <span class="current"><i class="fas fa-rupee-sign"></i> {{this.finalPrice}}</span>
              {{else}}
              <span class="current"><i class="fas fa-rupee-sign"></i> {{this.price}}</span>
              {{/if}}
            </div>
            <div class="card-actions">
              <button class="btn-add-cart" onclick="addToCart('{{this._id}}')">
                <i class="fas fa-shopping-cart"></i> Add
              </button>
              <a href="/view-product/{{this._id}}" class="btn-view-more">View More</a>
            </div>
          </div>
        </div>
        {{/each}}
      </div>

      {{> pagination}}

      <div class="text-center mt-4">
        <a href="/products" class="btn btn-success btn-lg px-5">
          <i class="fas fa-th-large me-2"></i>View More Products
        </a>
      </div>
    </div>
  </section>
  {{/if}}

  {{!-- Features Bar --}}
  <section class="features-bar">
    <div class="container">
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-truck"></i></div>
        <div>
          <h4>Free Shipping</h4>
          <p>On all orders within 2km</p>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-undo-alt"></i></div>
        <div>
          <h4>Free Returns</h4>
          <p>Returns are free within 9 days</p>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
        <div>
          <h4>100% Secure</h4>
          <p>Your payment is safe with us</p>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-headset"></i></div>
        <div>
          <h4>Support 24/7</h4>
          <p>Contact us 24 hours a day</p>
        </div>
      </div>
    </div>
  </section>

  {{!-- Newsletter --}}
  <section class="newsletter-section">
    <div class="container">
      <h2>Stay in the Loop</h2>
      <p>Get notified about new products, offers, and organic tips straight to your inbox.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault();Swal.fire('Coming Soon!','Newsletter subscription will be available soon.','info')">
        <input type="email" placeholder="Enter your email address" required>
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>
</main>

<input type="hidden" id="orderId" value="{{deliveryStatus}}">
<input type="hidden" id="deliveryStatus" value="{{delivery}}">

<script>
  function addToCart(prdId) {
    if (!prdId) return;
    $.ajax({
      url: '/add-to-cart/' + prdId,
      method: 'get',
      success: (response) => {
        if (response.status) {
          let count = $('#cartCount').html()
          count = parseInt(count) + 1
          $('#cartCount').html(count)
        }
      }
    })
  }
</script>

<script>
  $(document).ready(async function () {
    let delivery = document.getElementById('deliveryStatus')?.value
    let deliveryStatus = document.getElementById('orderId')?.value
    if (delivery == 'true') {
      const { value: text } = await Swal.fire({
        input: 'textarea',
        inputLabel: 'Hope you are happy with our product...',
        inputPlaceholder: 'Type your feedback here...',
        inputAttributes: { 'aria-label': 'Type your message here' },
        showCancelButton: false
      })
      if (text) {
        $.ajax({
          url: '/save-textfeedback',
          method: 'post',
          data: { feedback: text },
          success: (response) => {
            if (response.feedbackSatatus) {
              Swal.fire('Thank you for your valuable feedback')
            }
          }
        })
      } else {
        $.ajax({
          url: '/save-textfeedback',
          method: 'post',
          data: { feedback: 'No Feedback' },
          success: (response) => {
            if (response.feedbackSatatus) {
              Swal.fire('Thank you for your valuable feedback')
            }
          }
        })
      }
    }
  })
</script>
