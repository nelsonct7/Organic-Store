<main>
  <section class="page-hero">
    <div class="container">
      <h1>My Wishlist</h1>
      <p>Products you love, saved for later</p>
    </div>
  </section>

  <section class="py-4">
    <div class="container">
      {{#if isEmpty}}
      <div class="text-center py-5">
        <i class="far fa-heart" style="font-size:3rem;color:#ccc;"></i>
        <h4 class="mt-3">Your wishlist is empty</h4>
        <p class="text-muted">Browse products and add them to your wishlist.</p>
        <a href="/" class="btn btn-success">Shop Now</a>
      </div>
      {{else}}
      <div class="product-grid">
        {{#each products}}
        <div class="product-card">
          <div class="card-img-wrap">
            <a href="/view-product/{{this._id}}" class="card-img">
              {{#if this.images.length}}
              <img src="{{this.images.[0].url}}" alt="{{this.name}}">
              {{else}}
              <i class="fas fa-image" style="font-size:2rem;color:#ccc;"></i>
              {{/if}}
            </a>
            {{#if this.bestOffer}}
            <span class="card-badge">
              {{#ifCond this.bestOffer.type "percentage"}}{{this.bestOffer.value}}% OFF{{/ifCond}}
              {{#ifCond this.bestOffer.type "fixed"}}₹{{this.bestOffer.value}} OFF{{/ifCond}}
            </span>
            {{/if}}
            <button class="btn-add-cart-quick" onclick="addToCart('{{this._id}}')" title="Add to cart">
              <i class="fas fa-shopping-cart"></i>
            </button>
            <button class="btn-wishlist-remove" onclick="toggleWishlist('{{this._id}}')" title="Remove from wishlist">
              <i class="fas fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <h3><a href="/view-product/{{this._id}}">{{this.name}}</a></h3>
            <div class="card-price">
              {{#if this.bestOffer}}
              <span class="original"><i class="fas fa-rupee-sign"></i> {{this.price}}</span>
              <span class="current"><i class="fas fa-rupee-sign"></i> {{this.finalPrice}}</span>
              {{else}}
              <span class="current"><i class="fas fa-rupee-sign"></i> {{this.price}}</span>
              {{/if}}
            </div>
            <div class="card-actions">
              <button class="btn-add-cart" onclick="addToCart('{{this._id}}')">
                <i class="fas fa-shopping-cart"></i> Add
              </button>
              <a href="/view-product/{{this._id}}" class="btn-view-more">View More</a>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </section>
</main>

<style>
.btn-wishlist-remove {
  position: absolute;
  top: 8px;
  right: 40px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.9);
  color: #dc2626;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}
.btn-wishlist-remove:hover {
  background: #dc2626;
  color: #fff;
  transform: scale(1.1);
}
</style>

<script>
function addToCart(prdId) {
  if (!prdId) return;
  $.ajax({
    url: '/add-to-cart/' + prdId,
    method: 'get',
    success: function(response) {
      if (response.status) {
        var count = parseInt($('#cartCount').html()) + 1;
        $('#cartCount').html(count);
        Swal.fire({ icon: 'success', title: 'Added to Cart', timer: 1000, showConfirmButton: false });
      }
    }
  });
}

function toggleWishlist(productId) {
  $.ajax({
    url: '/wishlist/toggle/' + productId,
    method: 'POST',
    success: function(resp) {
      if (resp.status) {
        $('#wishlistCount').html(resp.count);
        if (!resp.added) {
          location.reload();
        }
      }
    }
  });
}
</script>
