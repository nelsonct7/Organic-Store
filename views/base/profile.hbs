<main>
  <section class="page-hero">
    <div class="container">
      <h1>My Account</h1>
      <p>Manage your profile, addresses and reviews</p>
    </div>
  </section>

  <section class="py-4">
    <div class="container">
      <div class="row g-4">

        {{! Profile Info + Addresses }}
        <div class="col-lg-5">
          {{! Profile Information }}
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h4>Profile Information</h4>
              <hr>
              <div class="row mb-2"><div class="col-sm-4 text-muted">Name</div><div class="col-sm-8">{{userData.name}}</div></div>
              <div class="row mb-2"><div class="col-sm-4 text-muted">Email</div><div class="col-sm-8">{{userData.email}}</div></div>
              <div class="row mb-2">
                <div class="col-sm-4 text-muted">Mobile</div>
                <div class="col-sm-8">
                  {{userData.mobile}}
                  <button class="btn btn-sm btn-outline-success ms-2" id="editMobileBtn"><i class="fas fa-pen"></i></button>
                </div>
              </div>
              <div class="mt-4">
                <a href="/orders" class="btn btn-success me-2">My Orders</a>
                <a href="/" class="btn btn-outline-success">Continue Shopping</a>
              </div>
            </div>
          </div>

          {{! Saved Addresses }}
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
              <h5 class="mb-0">Saved Addresses</h5>
              <button class="btn btn-sm btn-success" id="addAddressBtn"><i class="fas fa-plus"></i> Add</button>
            </div>
            <div class="card-body" id="addressesContainer">
              {{#if addresses.length}}
                {{#each addresses}}
                <div class="mb-3 pb-3 border-bottom address-item" data-address-id="{{this._id}}">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <strong>{{this.street}}</strong><br>
                      <span class="small text-muted">{{this.city}}, {{this.state}} - {{this.postalCode}}</span>
                      {{#if this.isDefault}}<span class="badge bg-success ms-2">Default</span>{{/if}}
                    </div>
                    <div class="d-flex gap-1">
                      <button class="btn btn-sm btn-outline-success edit-address-btn" data-address-id="{{this._id}}" data-street="{{this.street}}" data-city="{{this.city}}" data-state="{{this.state}}" data-postal="{{this.postalCode}}" data-country="{{this.country}}"><i class="fas fa-pen"></i></button>
                      <button class="btn btn-sm btn-outline-danger delete-address-btn" data-address-id="{{this._id}}"><i class="fas fa-trash"></i></button>
                    </div>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <p class="text-muted mb-0">No saved addresses.</p>
              {{/if}}
            </div>
          </div>
        </div>

        {{! Reviews }}
        <div class="col-lg-7">
          <div class="card shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
              <h5 class="mb-0">My Reviews</h5>
              <span class="badge bg-success">{{reviews.length}} review{{#ifCond reviews.length "===" 1}}{{else}}s{{/ifCond}}</span>
            </div>
            <div class="card-body" id="reviewsContainer">
              {{#if reviews.length}}
                {{#each reviews}}
                <div class="mb-3 pb-3 border-bottom review-item" data-review-id="{{this._id}}">
                  <div class="d-flex gap-3">
                    <div style="width:60px;height:60px;flex-shrink:0;border-radius:8px;overflow:hidden;background:#f3f4f6;">
                      {{#if this.productId.images.length}}
                      <img src="{{this.productId.images.[0].url}}" alt="" style="width:100%;height:100%;object-fit:cover;">
                      {{else}}
                      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;"><i class="fas fa-image" style="color:#d1d5db;"></i></div>
                      {{/if}}
                    </div>
                    <div style="flex:1;min-width:0;">
                      <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a href="/view-product/{{this.productId._id}}" class="fw-semibold text-success" style="text-decoration:none;">{{this.productId.name}}</a>
                        <span>
                          {{#times 5}}
                          <i class="fas fa-star {{#ifCond this "lte" ../rating}}text-warning{{else}}text-secondary{{/ifCond}}" style="font-size:0.75rem;"></i>
                          {{/times}}
                        </span>
                      </div>
                      <p class="mb-1 small review-comment">{{this.comment}}</p>
                      <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-success edit-review-btn" data-review-id="{{this._id}}" data-rating="{{this.rating}}" data-comment="{{this.comment}}"><i class="fas fa-edit"></i> Edit</button>
                        <button class="btn btn-sm btn-outline-danger delete-review-btn" data-review-id="{{this._id}}"><i class="fas fa-trash"></i> Delete</button>
                      </div>
                    </div>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <p class="text-muted mb-0">You haven't reviewed any products yet.</p>
              {{/if}}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<script>
// Delegate star clicks in SweetAlert2 modals
$(document).on('click', '.star-btn-edit', function() {
  var val = $(this).data('val');
  $('#swal-rating').val(val);
  $('.star-btn-edit').each(function() {
    $(this).toggleClass('fas', $(this).data('val') <= val).toggleClass('far', $(this).data('val') > val);
  });
});

$(document).ready(function() {
  // ---- Mobile Edit ----
  $('#editMobileBtn').on('click', function() {
    Swal.fire({
      title: 'Edit Mobile Number',
      html: '<input id="swal-mobile" class="form-control" value="{{userData.mobile}}" maxlength="10" placeholder="10-digit mobile number">',
      showCancelButton: true,
      confirmButtonText: 'Update',
      confirmButtonColor: '#16a34a',
      cancelButtonText: 'Cancel',
      preConfirm: function() {
        var mobile = $('#swal-mobile').val().replace(/[^0-9]/g, '');
        if (mobile.length !== 10) { Swal.showValidationMessage('Enter a valid 10-digit mobile number'); return false; }
        return mobile;
      }
    }).then(function(result) {
      if (!result.isConfirmed) return;
      $.ajax({
        url: '/profile/mobile',
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify({ mobile: result.value }),
        success: function(resp) {
          Swal.fire({ icon: 'success', title: 'Mobile updated!', timer: 1500, showConfirmButton: false })
            .then(function() { location.reload(); });
        },
        error: function(xhr) {
          var msg = 'Failed to update mobile';
          try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
          Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
      });
    });
  });

  // ---- Add Address ----
  $('#addAddressBtn').on('click', function() {
    Swal.fire({
      title: 'Add Address',
      html:
        '<input id="swal-street" class="form-control mb-2" placeholder="Street">' +
        '<input id="swal-city" class="form-control mb-2" placeholder="City">' +
        '<div class="row g-2 mb-2"><div class="col-6"><input id="swal-state" class="form-control" placeholder="State"></div>' +
        '<div class="col-6"><input id="swal-postal" class="form-control" placeholder="Postal Code"></div></div>' +
        '<input id="swal-country" class="form-control" value="India" placeholder="Country">',
      showCancelButton: true,
      confirmButtonText: 'Save',
      confirmButtonColor: '#16a34a',
      cancelButtonText: 'Cancel',
      preConfirm: function() {
        var street = $('#swal-street').val().trim();
        var city = $('#swal-city').val().trim();
        var state = $('#swal-state').val().trim();
        var postal = $('#swal-postal').val().trim();
        var country = $('#swal-country').val().trim() || 'India';
        if (!street || !city || !state || !postal) { Swal.showValidationMessage('All fields except country are required'); return false; }
        return { street: street, city: city, state: state, postalCode: postal, country: country };
      }
    }).then(function(result) {
      if (!result.isConfirmed) return;
      $.ajax({
        url: '/profile/address',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(result.value),
        success: function() {
          Swal.fire({ icon: 'success', title: 'Address added!', timer: 1500, showConfirmButton: false })
            .then(function() { location.reload(); });
        },
        error: function(xhr) {
          var msg = 'Failed to add address';
          try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
          if (msg.toLowerCase().indexOf('area') !== -1 || msg.toLowerCase().indexOf('delivery') !== -1) {
            $('#pincodeError').text(msg).show();
          }
          Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
      });
    });
  });

  // ---- Edit Address ----
  $(document).on('click', '.edit-address-btn', function() {
    var btn = $(this);
    var id = btn.data('address-id');
    Swal.fire({
      title: 'Edit Address',
      html:
        '<input id="swal-street" class="form-control mb-2" value="' + btn.data('street') + '">' +
        '<input id="swal-city" class="form-control mb-2" value="' + btn.data('city') + '">' +
        '<div class="row g-2 mb-2"><div class="col-6"><input id="swal-state" class="form-control" value="' + btn.data('state') + '"></div>' +
        '<div class="col-6"><input id="swal-postal" class="form-control" value="' + btn.data('postal') + '"></div></div>' +
        '<input id="swal-country" class="form-control" value="' + (btn.data('country') || 'India') + '">',
      showCancelButton: true,
      confirmButtonText: 'Update',
      confirmButtonColor: '#16a34a',
      cancelButtonText: 'Cancel',
      preConfirm: function() {
        var street = $('#swal-street').val().trim();
        var city = $('#swal-city').val().trim();
        var state = $('#swal-state').val().trim();
        var postal = $('#swal-postal').val().trim();
        var country = $('#swal-country').val().trim() || 'India';
        if (!street || !city || !state || !postal) { Swal.showValidationMessage('All fields except country are required'); return false; }
        return { street: street, city: city, state: state, postalCode: postal, country: country };
      }
    }).then(function(result) {
      if (!result.isConfirmed) return;
      $.ajax({
        url: '/profile/address/' + id,
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(result.value),
        success: function() {
          Swal.fire({ icon: 'success', title: 'Address updated!', timer: 1500, showConfirmButton: false })
            .then(function() { location.reload(); });
        },
        error: function(xhr) {
          var msg = 'Failed to update address';
          try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
          Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
      });
    });
  });

  // ---- Delete Address ----
  $(document).on('click', '.delete-address-btn', function() {
    var id = $(this).data('address-id');
    Swal.fire({
      title: 'Delete Address?',
      text: 'This action cannot be undone',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      confirmButtonText: 'Delete',
      cancelButtonText: 'Cancel'
    }).then(function(result) {
      if (!result.isConfirmed) return;
      $.ajax({
        url: '/profile/address/' + id,
        method: 'DELETE',
        success: function() {
          Swal.fire({ icon: 'success', title: 'Deleted!', timer: 1500, showConfirmButton: false })
            .then(function() { location.reload(); });
        },
        error: function(xhr) {
          var msg = 'Failed to delete address';
          try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
          Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
      });
    });
  });

  // ---- Edit Review ----
  $('.edit-review-btn').on('click', function() {
    var btn = $(this);
    var reviewId = btn.data('review-id');
    var currentRating = btn.data('rating');
    var currentComment = btn.data('comment');

    Swal.fire({
      title: 'Edit Review',
      html:
        '<div class="text-center mb-3" id="editStars">' +
          '<input type="hidden" id="swal-rating" value="' + currentRating + '">' +
          Array.from({length:5}, function(_,i) {
            var star = i+1;
            var filled = star <= currentRating ? 'fas' : 'far';
            return '<i class="' + filled + ' fa-star star-btn-edit" data-val="' + star + '" style="font-size:1.8rem;cursor:pointer;color:#ffc107;margin:0 2px;"></i>';
          }).join('') +
        '</div>' +
        '<textarea id="swal-comment" class="form-control" rows="3" placeholder="Your review">' + (currentComment || '') + '</textarea>',
      showCancelButton: true,
      confirmButtonText: 'Update',
      confirmButtonColor: '#16a34a',
      cancelButtonText: 'Cancel',
      preConfirm: function() {
        var rating = parseInt($('#swal-rating').val());
        if (!rating) { Swal.showValidationMessage('Please select a rating'); return false; }
        return { rating: rating, comment: $('#swal-comment').val().trim() };
      }
    }).then(function(result) {
      if (!result.isConfirmed) return;
      $.ajax({
        url: '/api/my-reviews/' + reviewId,
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(result.value),
        success: function() {
          Swal.fire({ icon: 'success', title: 'Updated!', timer: 1500, showConfirmButton: false })
            .then(function() { location.reload(); });
        },
        error: function(xhr) {
          var msg = 'Failed to update review';
          try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
          Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
      });
    });
  });

  // ---- Delete Review ----
  $('.delete-review-btn').on('click', function() {
    var reviewId = $(this).data('review-id');
    Swal.fire({
      title: 'Delete Review?',
      text: 'This action cannot be undone',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      confirmButtonText: 'Delete',
      cancelButtonText: 'Cancel'
    }).then(function(result) {
      if (!result.isConfirmed) return;
      $.ajax({
        url: '/api/my-reviews/' + reviewId,
        method: 'DELETE',
        success: function() {
          Swal.fire({ icon: 'success', title: 'Deleted!', timer: 1500, showConfirmButton: false })
            .then(function() { location.reload(); });
        },
        error: function(xhr) {
          var msg = 'Failed to delete review';
          try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
          Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
      });
    });
  });
});
</script>