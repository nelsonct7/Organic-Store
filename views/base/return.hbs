<main>
  <section class="page-hero">
    <div class="container">
      <h1>Return Items</h1>
      <p>Order #{{order._id}}</p>
    </div>
  </section>

  <section class="py-4">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">Items in this Order</h5></div>
            <div class="card-body">
              {{#each order.items}}
              <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <div>
                  <strong>{{this.orderItemId.productName}}</strong>
                  <span class="text-muted small">× {{this.orderItemId.quantity}}</span>
                </div>
                <span>₹{{multiply this.orderItemId.finalUnitPrice this.orderItemId.quantity}}</span>
              </div>
              {{/each}}
              <hr>
              <div class="d-flex justify-content-between fw-bold">
                <span>Grand Total</span>
                <span>₹{{order.grandTotal}}</span>
              </div>
            </div>
          </div>

          <div class="card shadow-sm">
            <div class="card-header bg-white"><h5 class="mb-0">Return Reason</h5></div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Why are you returning? <span class="text-danger">*</span></label>
                <textarea class="form-control" id="returnReason" rows="3" placeholder="Describe the issue with your order..." required></textarea>
              </div>
              <div class="d-flex gap-2">
                <button class="btn btn-success" id="submitReturnBtn">
                  <i class="fas fa-undo-alt"></i> Submit Return Request
                </button>
                <a href="/orders" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card shadow-sm">
            <div class="card-header bg-white"><h5 class="mb-0">Return Policy</h5></div>
            <div class="card-body small">
              <ul class="mb-0 ps-3">
                <li>Returns accepted within 5 days of delivery</li>
                <li>Items must be in original condition</li>
                <li>Refund will be credited to your wallet</li>
                <li>Wallet balance can be used for future purchases</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
$('#submitReturnBtn').on('click', function() {
  var reason = $('#returnReason').val().trim();
  if (!reason) {
    Swal.fire({ icon: 'error', title: 'Reason Required', text: 'Please describe why you are returning.' });
    return;
  }
  var btn = $(this);
  btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Submitting...');
  $.ajax({
    url: '/orders/{{order._id}}/return',
    method: 'POST',
    contentType: 'application/json',
    data: JSON.stringify({ reason: reason }),
    success: function(resp) {
      if (resp.status) {
        Swal.fire({ icon: 'success', title: 'Return Requested', text: 'We will review your request shortly.', timer: 2000, showConfirmButton: false })
          .then(function() { window.location.href = '/orders'; });
      }
    },
    error: function(xhr) {
      btn.prop('disabled', false).html('<i class="fas fa-undo-alt"></i> Submit Return Request');
      var msg = 'Failed to submit return';
      try { msg = JSON.parse(xhr.responseText).message; } catch(e) {}
      Swal.fire({ icon: 'error', title: 'Error', text: msg });
    }
  });
});
</script>
