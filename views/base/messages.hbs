<div class="container py-4">
  <div class="row">
    <div class="col-12 mb-4">
      <h4 style="font-weight: 600; color: #1f2937;">My Messages</h4>
      <p style="color: #6b7280; font-size: 0.9rem;">Send a message to the admin or view your conversation history.</p>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-5 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
          <h6 class="mb-0" style="font-weight: 600; color: #1f2937;">New Message</h6>
        </div>
        <div class="card-body">
          <form id="messageForm">
            <div class="mb-3">
              <label for="subject" class="form-label" style="font-size: 0.875rem; font-weight: 500; color: #374151;">Subject</label>
              <input type="text" class="form-control" id="subject" name="subject" maxlength="200" required
                style="border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.875rem;">
            </div>
            <div class="mb-3">
              <label for="message" class="form-label" style="font-size: 0.875rem; font-weight: 500; color: #374151;">Message</label>
              <textarea class="form-control" id="message" name="message" rows="5" maxlength="2000" required
                style="border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.875rem; resize: vertical;"></textarea>
              <div class="text-end mt-1"><small id="charCount" style="color: #9ca3af;">0 / 2000</small></div>
            </div>
            <button type="submit" class="btn w-100" style="background: #16a34a; color: #fff; font-weight: 500; border-radius: 6px; padding: 10px;">
              <i class="fas fa-paper-plane me-1"></i> Send Message
            </button>
          </form>
          <div id="messageSuccess" class="alert alert-success d-none mt-3 mb-0" style="font-size: 0.875rem;">
            <i class="fas fa-check-circle me-1"></i> Message sent! Admin will reply soon.
          </div>
          <div id="messageError" class="alert alert-danger d-none mt-3 mb-0" style="font-size: 0.875rem;"></div>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card border-0 shadow-sm">
        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
          <h6 class="mb-0" style="font-weight: 600; color: #1f2937;">Conversation History</h6>
        </div>
        <div class="card-body p-0">
          {{#if conversations.length}}
          <div class="list-group list-group-flush" id="conversationList">
            {{#each conversations}}
            <div class="list-group-item p-3 conversation-item" data-id="{{this._id}}" style="cursor: pointer; border-left: 3px solid transparent; transition: all 0.2s;"
              onmouseover="this.style.borderLeftColor='#16a34a'; this.style.background='#f9fafb';"
              onmouseout="this.style.borderLeftColor='transparent'; this.style.background='';">
              <div class="d-flex justify-content-between align-items-start">
                <div style="flex: 1; min-width: 0;">
                  <h6 class="mb-1" style="font-weight: 600; color: #1f2937; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{this.subject}}</h6>
                  <small style="color: #9ca3af;">
                    <i class="far fa-clock me-1"></i>
                    <time datetime="{{this.updatedAt}}">{{timeAgo this.updatedAt}}</time>
                    &middot; {{this.messages.length}} message{{#unless (eq this.messages.length 1)}}s{{/unless}}
                  </small>
                </div>
                <span class="badge ms-2" style="flex-shrink: 0;
                  {{#if (eq this.status "open")}}background: #fef3c7; color: #92400e;
                  {{else if (eq this.status "replied")}}background: #dcfce7; color: #166534;
                  {{else}}background: #e5e7eb; color: #4b5563;{{/if}}
                  font-weight: 500; font-size: 0.75rem;">
                  {{this.status}}
                </span>
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="text-center py-5" style="color: #9ca3af;">
            <i class="fas fa-envelope-open-text" style="font-size: 2.5rem; display: block; margin-bottom: 12px;"></i>
            <p class="mb-0">No messages yet. Send your first message to the admin!</p>
          </div>
          {{/if}}
        </div>
      </div>

      <div id="conversationDetail" class="card border-0 shadow-sm mt-3 d-none">
        <div class="card-header d-flex justify-content-between align-items-center"
          style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
          <h6 class="mb-0" style="font-weight: 600; color: #1f2937;" id="detailSubject">Conversation</h6>
          <button class="btn btn-sm btn-outline-secondary" onclick="closeDetail()" style="border-radius: 6px;">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="card-body" id="detailBody" style="max-height: 400px; overflow-y: auto;"></div>
        <div class="card-footer" style="background: #f8fafc; border-top: 1px solid #e5e7eb;">
          <form id="replyForm" class="d-none">
            <input type="hidden" id="replyConversationId">
            <div class="input-group">
              <textarea class="form-control" id="replyContent" rows="2" maxlength="2000" placeholder="Type your reply..."
                style="border: 1px solid #d1d5db; border-radius: 6px 0 0 6px; font-size: 0.875rem; resize: none;"></textarea>
              <button type="submit" class="btn" style="background: #16a34a; color: #fff; border-radius: 0 6px 6px 0;">
                <i class="fas fa-reply"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.conversation-item.active {
  border-left-color: #16a34a !important;
  background: #f0fdf4 !important;
}
.message-bubble {
  max-width: 80%;
  padding: 10px 14px;
  border-radius: 12px;
  margin-bottom: 10px;
  font-size: 0.875rem;
  line-height: 1.5;
  word-wrap: break-word;
}
.message-bubble.user {
  background: #dcfce7;
  color: #166534;
  margin-left: auto;
  border-bottom-right-radius: 4px;
}
.message-bubble.admin {
  background: #f3f4f6;
  color: #1f2937;
  margin-right: auto;
  border-bottom-left-radius: 4px;
}
.message-time {
  font-size: 0.7rem;
  color: #9ca3af;
  margin-top: 4px;
}
</style>

<script>
$('#messageForm').on('submit', function(e) {
  e.preventDefault();
  var $btn = $(this).find('button[type="submit"]');
  $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Sending...');
  $('#messageSuccess').addClass('d-none');
  $('#messageError').addClass('d-none');

  $.ajax({
    url: '/messages',
    method: 'POST',
    data: $(this).serialize(),
    success: function(res) {
      if (res.status) {
        $('#messageForm')[0].reset();
        $('#charCount').text('0 / 2000');
        $('#messageSuccess').removeClass('d-none');
        setTimeout(function() { location.reload(); }, 1500);
      }
    },
    error: function(xhr) {
      var msg = 'Failed to send message. Please try again.';
      try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch(e) {}
      $('#messageError').text(msg).removeClass('d-none');
    },
    complete: function() {
      $btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Send Message');
    }
  });
});

$('#message').on('input', function() {
  $('#charCount').text($(this).val().length + ' / 2000');
});

$('.conversation-item').on('click', function() {
  var id = $(this).data('id');
  $('.conversation-item').removeClass('active');
  $(this).addClass('active');
  loadConversation(id);
});

function loadConversation(id) {
  $.getJSON('/messages/' + id, function(res) {
    if (!res.status) return;
    var c = res.conversation;
    $('#detailSubject').text(c.subject);
    var html = '';
    (c.messages || []).forEach(function(m) {
      var cls = m.sender === 'user' ? 'user' : 'admin';
      var label = m.sender === 'user' ? 'You' : 'Admin';
      var time = m.createdAt ? new Date(m.createdAt).toLocaleString() : '';
      html += '<div class="message-bubble ' + cls + '">';
      html += '<strong style="font-size:0.75rem;">' + label + '</strong><br>';
      html += m.content;
      html += '<div class="message-time">' + time + '</div>';
      html += '</div>';
    });
    $('#detailBody').html(html);
    $('#replyConversationId').val(id);

    if (c.status !== 'closed') {
      $('#replyForm').removeClass('d-none');
    } else {
      $('#replyForm').addClass('d-none');
    }

    $('#conversationDetail').removeClass('d-none');
    $('#detailBody').scrollTop($('#detailBody')[0].scrollHeight);
  });
}

function closeDetail() {
  $('#conversationDetail').addClass('d-none');
  $('.conversation-item').removeClass('active');
}

$('#replyForm').on('submit', function(e) {
  e.preventDefault();
  var id = $('#replyConversationId').val();
  var content = $('#replyContent').val().trim();
  if (!content) return;

  $.ajax({
    url: '/messages/' + id + '/reply',
    method: 'POST',
    data: { content: content },
    success: function(res) {
      if (res.status) {
        $('#replyContent').val('');
        loadConversation(id);
      }
    },
    error: function() {
      alert('Failed to send reply.');
    }
  });
});
</script>
