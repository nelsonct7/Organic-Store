<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 — Server Error</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/err403.css">
  <style>
    html, body { height: 100%; margin: 0; }
    body { font-family: 'Inter', sans-serif; background: #f8f9fc; display: flex; align-items: center; justify-content: center; color: #32325d; }
    .error-code-500 { font-size: 120px; font-weight: 800; line-height: 1; background: linear-gradient(135deg, #dc2626, #f97316); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 8px; }
    .error-icon-500 { width: 80px; height: 80px; margin: 0 auto 20px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 8px rgba(220, 38, 38, 0.1); font-size: 32px; color: #dc2626; }
    .error-title-500 { font-size: 28px; font-weight: 700; margin-bottom: 12px; }
    .error-text-500 { font-size: 16px; color: #8898aa; line-height: 1.6; margin-bottom: 32px; max-width: 400px; margin-left: auto; margin-right: auto; }
    .error-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  </style>
</head>
<body>
  <div style="text-align:center;max-width:560px;padding:40px 24px;">
    <div class="error-icon-500">
      <i class="fas fa-exclamation-triangle"></i>
    </div>
    <div class="error-code-500">500</div>
    <div class="error-title-500">Server Error</div>
    <p class="error-text-500">{{message}}</p>
    <div class="error-actions">
      <a href="/" class="btn-primary-admin"><i class="fas fa-home"></i> Go Home</a>
      <a href="javascript:location.reload()" class="btn-outline-admin"><i class="fas fa-redo"></i> Try Again</a>
    </div>
  </div>
</body>
</html>