<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} — Forbidden</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/err403.css">
</head>
<body>
  <div class="error-403">
    <div class="lock-icon">
      <i class="fas fa-lock"></i>
    </div>
    <div class="error-code">403</div>
    <div class="error-title">Access Forbidden</div>
    <p class="error-text">You don't have permission to access this area. Please contact your administrator if you believe this is a mistake.</p>
    <div class="error-actions">
      <a href="/admin" class="btn-primary-admin">
        <i class="fas fa-arrow-left"></i> Admin Login
      </a>
      <a href="/" class="btn-outline-admin">
        <i class="fas fa-home"></i> Home
      </a>
    </div>
  </div>
</body>
</html>