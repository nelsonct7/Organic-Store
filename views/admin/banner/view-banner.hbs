<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Banners</h4>
  <a href="/admin/add-banner" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 6px 16px; font-size: 0.8125rem; text-decoration: none;">+ Add Banner</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="categorytable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Image</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Options</th>
          </tr>
        </thead>
        <tbody>
          {{#each banners}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td class="px-3 py-3">
              <img src="/banner-images/{{this.img_path}}" alt="" style="width: 400px; height: 160px; border-radius: 8px; object-fit: cover;">
            </td>
            <td class="px-3 py-3">
              <button onclick="deletbann('{{this._id}}')" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem;">Delete</button>
            </td>
          </tr>
          {{/each}}

          {{#if (eq banners.length 0)}}
          <tr>
            <td colspan="2" class="text-center py-5" style="color: #9ca3af;">
              <i class="fa-solid fa-image" style="font-size: 2rem; display: block; margin-bottom: 8px;"></i>
              No banners yet. <a href="/admin/add-banner" style="color: #16a34a;">Add one</a>
            </td>
          </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination pagination=pagination}}

<script>
function deletbann(banId){
  $.ajax({
    url: '/admin/delete-banner/' + banId,
    method: 'delete',
    success: (response) => {
      if (response.status) {
        Swal.fire({
          title: 'Deleted',
          text: "Banner deleted successfully",
          icon: 'info',
          showCancelButton: false,
          confirmButtonColor: '#16a34a',
          confirmButtonText: 'Ok'
        }).then((result) => {
          if (result.isConfirmed) {
            location.href = '/admin/banner'
          }
        })
      }
    }
  })
}
</script>
