<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h4 class="mb-1" style="font-weight: 600; color: #1f2937;">Reviews: {{product.name}}</h4>
    <a href="/admin/reviews" class="small text-success" style="text-decoration: none;">&larr; Back to all products</a>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">User</th>
            <th class="py-3 px-3 text-center" style="font-weight: 600; color: #4b5563;">Rating</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Comment</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Date</th>
            <th class="py-3 px-3 text-center" style="font-weight: 600; color: #4b5563;">Approved</th>
            <th class="py-3 px-3 text-end" style="font-weight: 600; color: #4b5563;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each reviews}}
          <tr>
            <td class="py-3 px-3">
              <div style="font-weight: 500; color: #1f2937;">{{this.userId.name}}</div>
              <div style="font-size: 0.75rem; color: #9ca3af;">{{this.userId.email}}</div>
            </td>
            <td class="py-3 px-3 text-center">
              <span class="fw-bold" style="color: #f59e0b;">{{this.rating}}</span><span class="text-muted" style="font-size: 0.75rem;">/5</span>
            </td>
            <td class="py-3 px-3" style="max-width: 300px;">
              <div style="word-break: break-word;">{{this.comment}}</div>
            </td>
            <td class="py-3 px-3 text-muted" style="font-size: 0.8125rem;">{{timeAgo this.createdAt}}</td>
            <td class="py-3 px-3 text-center">
              {{#if this.isApproved}}
              <span class="badge bg-success">Yes</span>
              {{else}}
              <span class="badge bg-secondary">No</span>
              {{/if}}
            </td>
            <td class="py-3 px-3 text-end">
              <button class="btn btn-sm toggle-approval" data-review-id="{{this._id}}" style="background: {{#if this.isApproved}}#f59e0b{{else}}#16a34a{{/if}}; color: #fff; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.75rem;">
                {{#if this.isApproved}}<i class="fa-solid fa-eye-slash"></i> Hide{{else}}<i class="fa-solid fa-check"></i> Approve{{/if}}
              </button>
            </td>
          </tr>
          {{else}}
          <tr><td colspan="6" class="text-center py-4 text-muted">No reviews for this product yet</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination}}

<script>
$(document).ready(function() {
  $('.toggle-approval').on('click', function() {
    var btn = $(this);
    var reviewId = btn.data('review-id');
    btn.prop('disabled', true);
    $.ajax({
      url: '/admin/review/toggle-approval/' + reviewId,
      method: 'POST',
      success: function(resp) {
        if (resp.status) {
          location.reload();
        }
      },
      error: function() {
        btn.prop('disabled', false);
        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to update review status' });
      }
    });
  });
});
</script>
