<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Product Reviews</h4>
</div>

<form method="GET" action="/admin/reviews" class="mb-3">
  <div class="input-group" style="max-width: 400px;">
    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search products..." value="{{searchValue}}" style="border: 1px solid #d1d5db; border-radius: 6px 0 0 6px; font-size: 0.8125rem;">
    <input type="hidden" name="page" value="1">
    <button class="btn btn-sm" type="submit" style="background: #16a34a; color: #fff; border: none; border-radius: 0 6px 6px 0; font-size: 0.8125rem; padding: 6px 14px;">
      <i class="fa-solid fa-search"></i>
    </button>
  </div>
</form>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Product</th>
            <th class="py-3 px-3 text-center" style="font-weight: 600; color: #4b5563;">Avg. Rating</th>
            <th class="py-3 px-3 text-center" style="font-weight: 600; color: #4b5563;">Reviews</th>
            <th class="py-3 px-3 text-end" style="font-weight: 600; color: #4b5563;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr>
            <td class="py-3 px-3">
              <div class="d-flex align-items-center gap-3">
                {{#if this.images.length}}
                <img src="{{this.images.[0].url}}" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px;">
                {{else}}
                <div style="width: 40px; height: 40px; background: #f3f4f6; border-radius: 6px; display: flex; align-items: center; justify-content: center;"><i class="fas fa-image" style="color: #d1d5db;"></i></div>
                {{/if}}
                <div>
                  <div style="font-weight: 500; color: #1f2937;">{{this.name}}</div>
                  <div style="font-size: 0.75rem; color: #9ca3af;">{{this.category.name}}</div>
                </div>
              </div>
            </td>
            <td class="py-3 px-3 text-center">
              {{#if this.reviewStats.count}}
              <span class="fw-bold" style="color: #16a34a;">{{this.reviewStats.average}}</span>
              <span class="text-muted" style="font-size: 0.75rem;">/ 5</span>
              {{else}}
              <span class="text-muted">—</span>
              {{/if}}
            </td>
            <td class="py-3 px-3 text-center">{{this.reviewStats.count}}</td>
            <td class="py-3 px-3 text-end">
              <a href="/admin/reviews/{{this._id}}" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.75rem; text-decoration: none;">
                <i class="fa-solid fa-star"></i> View Reviews
              </a>
            </td>
          </tr>
          {{else}}
          <tr><td colspan="4" class="text-center py-4 text-muted">No products found</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination}}
