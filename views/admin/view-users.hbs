<div class="d-flex align-items-center justify-content-between mb-4">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Users</h4>
  <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500;">{{users.length}} total</span>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="usrtable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Status</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Name</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Email</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Mobile</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td class="px-3 py-3">
              {{#if this.status}}
              <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Active</span>
              {{else}}
              <span class="badge" style="background: #fee2e2; color: #dc2626; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Inactive</span>
              {{/if}}
            </td>
            <td class="px-3 py-3" style="font-weight: 500; color: #1f2937;">{{this.user_name}}</td>
            <td class="px-3 py-3" style="color: #6b7280;">{{this.user_email}}</td>
            <td class="px-3 py-3" style="color: #4b5563;">{{this.user_mobile}}</td>
            <td class="px-3 py-3">
              {{#if this.deleted}}
                <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Edit</button>
                <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Delete</button>
              {{else}}
                <div class="d-flex gap-1">
                  <a href="/admin/edit-user/{{this._id}}" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem; text-decoration: none;">Edit</a>
                  <button onclick="deleteUser('{{this._id}}')" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem;">Delete</button>
                </div>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  $(function () { $('#usrtable').DataTable(); });

  function deleteUser(usrId){
    Swal.fire({
      title: 'Are you sure?',
      text: "You won't be able to revert this!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#16a34a',
      cancelButtonColor: '#dc2626',
      confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
      if (result.isConfirmed) {
        $.ajax({
          url: '/admin/delete-user/' + usrId,
          method: 'get',
          success: (response) => {
            if (response.deleted) {
              Swal.fire('Deleted!', 'The user has been deleted.', 'success')
              location.reload()
            }
          }
        })
      }
    })
  }
</script>
