<section class="mt-3">
  <div class="container-fluid">
    <h3>Add Product</h3>
    <div class="row m-5">
      <div
        class="col-md-10 pb-4 pt-4 shadow-lg p-3 mb-5 bg-body rounded border border-dark"
      >
        <form
          id="addProductForm"
          enctype="multipart/form-data"
          method="post"
          action="/admin/add-products"
        >
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input
              type="text"
              class="form-control"
              name="title"
              id="title"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-select" name="category" id="category" required>
              <option value="" selected>Please Select</option>
              {{#each category}}
                <option value="{{this._id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <input
              type="text"
              class="form-control"
              name="description"
              id="description"
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Storage Specification</label>
            <input
              type="text"
              class="form-control"
              name="storageSpec"
              id="spec"
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Base Price</label>
            <input
              type="number"
              class="form-control"
              name="price"
              id="price"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Godown Stock</label>
            <input
              type="number"
              class="form-control"
              name="stock"
              id="stock"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Metrics</label>
            <select class="form-select" name="metrics" id="metrics" required>
              <option value="" selected>Please Select</option>
              {{#each metrics}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </div>

          {{! Available Units — auto-generated when metric + base price are set }}
          <div class="mb-3">
            <label class="form-label">Available Units <small class="text-muted">(auto-suggested from metric &amp; price; edit as needed)</small></label>
            <div id="unitsContainer">
              <div class="row g-2 unit-row">
                <div class="col-3">
                  <input type="text" class="form-control form-control-sm" name="unitLabel[]" placeholder="e.g. 1 kg">
                </div>
                <div class="col-3">
                  <select class="form-select form-select-sm" name="unitMetric[]">
                    <option value="grams">grams</option>
                    <option value="ml">ml</option>
                    <option value="numbers">numbers</option>
                  </select>
                </div>
                <div class="col-2">
                  <input type="number" class="form-control form-control-sm" name="unitMeasure[]" placeholder="Qty">
                </div>
                <div class="col-2">
                  <input type="number" step="0.01" class="form-control form-control-sm" name="unitPrice[]" placeholder="Price">
                </div>
                <div class="col-2">
                  <button type="button" class="btn btn-sm btn-outline-danger remove-unit" style="display:none;">&times;</button>
                </div>
              </div>
            </div>
            <button type="button" id="addUnitRow" class="btn btn-sm btn-outline-success mt-2">+ Add Unit</button>
          </div>

          <div class="mb-3">
            <label class="form-label">Status</label>
            <select class="form-select" name="status" id="status">
              <option value="available">Available</option>
              <option value="out-of-stock">Out of Stock</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Images</label>
            <div
              id="addImagePreviews"
              class="d-flex flex-wrap gap-2 mb-2"
            ></div>
            <input
              class="form-control"
              type="file"
              id="addFileInput"
              accept="image/*"
              multiple
            />
          </div>
          <button type="submit" class="btn btn-primary">Submit</button>
          <button type="reset" class="btn btn-primary">Clear</button>
          <a href="/admin/view-products" class="btn btn-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</section>

<script src="/javascripts/adminProductAdd.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var container = document.getElementById('unitsContainer');
  var addBtn = document.getElementById('addUnitRow');
  var priceInput = document.getElementById('price');
  var metricsSelect = document.getElementById('metrics');

  function generateDefaultUnits() {
    var metric = metricsSelect.value;
    var basePrice = parseFloat(priceInput.value);
    if (!metric || !basePrice) return;

    var suggestions = [];
    if (metric === 'Kg') {
      suggestions = [
        { label: '250g', metric: 'grams', measure: 250, price: (basePrice / 4).toFixed(2) },
        { label: '500g', metric: 'grams', measure: 500, price: (basePrice / 2).toFixed(2) },
        { label: '1 kg', metric: 'grams', measure: 1000, price: basePrice.toFixed(2) },
      ];
    } else if (metric === 'Li') {
      suggestions = [
        { label: '250ml', metric: 'ml', measure: 250, price: (basePrice / 4).toFixed(2) },
        { label: '500ml', metric: 'ml', measure: 500, price: (basePrice / 2).toFixed(2) },
        { label: '1 L', metric: 'ml', measure: 1000, price: basePrice.toFixed(2) },
      ];
    } else if (metric === 'Piece') {
      suggestions = [
        { label: '1', metric: 'numbers', measure: 1, price: basePrice.toFixed(2) },
        { label: '2', metric: 'numbers', measure: 2, price: (basePrice * 2).toFixed(2) },
        { label: '5', metric: 'numbers', measure: 5, price: (basePrice * 5).toFixed(2) },
        { label: '10', metric: 'numbers', measure: 10, price: (basePrice * 10).toFixed(2) },
      ];
    }

    container.innerHTML = '';
    suggestions.forEach(function(s, idx) {
      var div = document.createElement('div');
      div.className = 'row g-2 unit-row';
      var canRemove = suggestions.length > 1;
      div.innerHTML =
        '<div class="col-3"><input type="text" class="form-control form-control-sm" name="unitLabel[]" value="' + s.label + '"></div>' +
        '<div class="col-3"><select class="form-select form-select-sm" name="unitMetric[]">' +
          '<option value="grams"' + (s.metric === 'grams' ? ' selected' : '') + '>grams</option>' +
          '<option value="ml"' + (s.metric === 'ml' ? ' selected' : '') + '>ml</option>' +
          '<option value="numbers"' + (s.metric === 'numbers' ? ' selected' : '') + '>numbers</option>' +
        '</select></div>' +
        '<div class="col-2"><input type="number" class="form-control form-control-sm" name="unitMeasure[]" value="' + s.measure + '"></div>' +
        '<div class="col-2"><input type="number" step="0.01" class="form-control form-control-sm" name="unitPrice[]" value="' + s.price + '"></div>' +
        '<div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger remove-unit" style="' + (canRemove ? '' : 'display:none;') + '">&times;</button></div>';
      container.appendChild(div);
    });
  }

  metricsSelect.addEventListener('change', generateDefaultUnits);
  priceInput.addEventListener('blur', function() {
    if (metricsSelect.value) generateDefaultUnits();
  });

  container.addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-unit')) {
      var row = e.target.closest('.unit-row');
      if (container.querySelectorAll('.unit-row').length > 1) {
        row.remove();
      }
    }
  });

  addBtn.addEventListener('click', function() {
    var template = container.querySelector('.unit-row');
    if (!template) {
      // No rows yet — create a blank one
      var div = document.createElement('div');
      div.className = 'row g-2 unit-row';
      div.innerHTML =
        '<div class="col-3"><input type="text" class="form-control form-control-sm" name="unitLabel[]" placeholder="e.g. 500g"></div>' +
        '<div class="col-3"><select class="form-select form-select-sm" name="unitMetric[]">' +
          '<option value="grams">grams</option>' +
          '<option value="ml">ml</option>' +
          '<option value="numbers">numbers</option>' +
        '</select></div>' +
        '<div class="col-2"><input type="number" class="form-control form-control-sm" name="unitMeasure[]" placeholder="Qty"></div>' +
        '<div class="col-2"><input type="number" step="0.01" class="form-control form-control-sm" name="unitPrice[]" placeholder="Price"></div>' +
        '<div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger remove-unit">&times;</button></div>';
      container.appendChild(div);
    } else {
      var newRow = template.cloneNode(true);
      newRow.querySelectorAll('input').forEach(function(inp) { inp.value = ''; });
      newRow.querySelectorAll('select').forEach(function(sel) { sel.selectedIndex = 0; });
      newRow.querySelector('.remove-unit').style.display = 'inline-block';
      container.appendChild(newRow);
    }
  });
});
</script>
