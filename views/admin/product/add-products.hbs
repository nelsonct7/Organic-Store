<section class="mt-3">
  <div class="container-fluid">
    <h3>Add Product</h3>
    <div class="row m-5">
      <div
        class="col-md-10 pb-4 pt-4 shadow-lg p-3 mb-5 bg-body rounded border border-dark"
      >
        <form
          id="addProductForm"
          enctype="multipart/form-data"
          method="post"
          action="/admin/add-products"
        >
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input
              type="text"
              class="form-control"
              name="title"
              id="title"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-select" name="category" id="category" required>
              <option value="" selected>Please Select</option>
              {{#each category}}
                <option value="{{this._id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <input
              type="text"
              class="form-control"
              name="description"
              id="description"
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Storage Specification</label>
            <input
              type="text"
              class="form-control"
              name="storageSpec"
              id="spec"
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Price</label>
            <input
              type="number"
              class="form-control"
              name="price"
              id="price"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Godown Stock</label>
            <input
              type="number"
              class="form-control"
              name="stock"
              id="stock"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Metrics</label>
            <select class="form-select" name="metrics" id="metrics" required>
              <option value="" selected>Please Select</option>
              {{#each metrics}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select class="form-select" name="status" id="status">
              <option value="available">Available</option>
              <option value="out-of-stock">Out of Stock</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Images</label>
            <div
              id="addImagePreviews"
              class="d-flex flex-wrap gap-2 mb-2"
            ></div>
            <input
              class="form-control"
              type="file"
              id="addFileInput"
              accept="image/*"
              multiple
            />
          </div>
          <button type="submit" class="btn btn-primary">Submit</button>
          <button type="reset" class="btn btn-primary">Clear</button>
          <a href="/admin/view-products" class="btn btn-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</section>

<script src="/javascripts/adminProductAdd.js"></script>