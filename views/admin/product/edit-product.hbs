<section class="ms-5">
  <div class="container-fluid">
    <h3>Edit Product</h3>
    <div class="row">
      <div class="col-md-10 mt-3 shadow-lg p-5 mb-5 bg-body rounded border border-dark">
        <form id="editProductForm" enctype="multipart/form-data" method="post" action="/admin/edit-products/{{product._id}}" class="col-8 mb-5">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" class="form-control" name="title" value="{{product.title}}">
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <input type="text" class="form-control" name="description" value="{{product.description}}">
          </div>
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-select" name="category">
              {{#each category}}
                <option value="{{this._id}}" {{#if (eq this._id ../product.category)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Storage Specification</label>
            <input type="text" class="form-control" name="storageSpec" value="{{product.storageSpec}}">
          </div>
          <div class="mb-3">
            <label class="form-label">Price</label>
            <input type="number" class="form-control" name="price" value="{{product.price}}">
          </div>
          <div class="mb-3">
            <label class="form-label">Godown Stock</label>
            <input type="number" class="form-control" name="stock" value="{{product.stock}}">
          </div>
          <div class="mb-3">
            <label class="form-label">Metrics</label>
            <select class="form-select" name="metrics">
              <option value="">Please Select</option>
              {{#each metrics}}
                <option value="{{this}}" {{#if (eq this ../product.metrics)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
              <option value="available" {{#if (eq product.status "available")}}selected{{/if}}>Available</option>
              <option value="out-of-stock" {{#if (eq product.status "out-of-stock")}}selected{{/if}}>Out of Stock</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Images</label>
            <div id="existingImages" class="d-flex flex-wrap gap-2 mb-2">
              {{#each product.img_path}}
                <div class="position-relative" data-image-id="{{this.id}}">
                <img src="/product-images/{{this.url}}" alt="" style="width:100px;height:100px;object-fit:cover;border-radius:6px;">
                {{#unless ../isOnlyImage}}
                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0" style="border-radius:50%;padding:2px 4px;font-size:12px;line-height:1;" onclick="deleteExistingImage('{{this.id}}', this)">
                  &times;
                </button>
                {{/unless}}
              </div>
              {{/each}}
            </div>
            <div id="newImagePreviews" class="d-flex flex-wrap gap-2 mb-2"></div>
            <input class="form-control" type="file" id="newFileInput" accept="image/*" multiple>
          </div>

          <a href="/admin/view-products" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">Submit</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>var productId = '{{product._id}}';</script>
<script src="/javascripts/adminProductEdit.js"/>
