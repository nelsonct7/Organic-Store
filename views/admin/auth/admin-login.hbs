<div class="admin-login-wrapper">
  <div class="admin-login-card">
    <div class="login-logo">
      <div class="logo-icon">OS</div>
      <h2>Organic Store</h2>
      <p>Admin Dashboard</p>
    </div>
    <form action="/admin/login" method="post">
      <div class="mb-4">
        <label for="inputAdmin" class="form-label">Email</label>
        <input
          type="text"
          class="form-control"
          id="inputAdmin"
          name="admin_field"
          placeholder="Enter your email"
          required
        />
      </div>
      <div class="mb-4">
        <label for="inputAdminPassword" class="form-label">Password</label>
        <input
          type="password"
          class="form-control"
          id="inputAdminPassword"
          name="admin_password"
          placeholder="Enter your password"
          required
        />
      </div>
      <button type="submit" class="btn btn-primary w-100 mb-2">Sign In</button>
      <div class="text-center mt-3">
        <a href="/" class="text-muted" style="font-size:0.8125rem;">← Back to store</a>
      </div>
      {{#if flash.error}}
        <div class="alert alert-danger text-center mt-4 mb-0">
          {{flash.error}}
        </div>
      {{/if}}
    </form>
  </div>
</div>
