<section class="ms-5 mt-5">
<div class="row">
    <div class="col-md-8 shadow-lg p-3 mb-5 bg-body rounded border">
<table class="table mt-5" id="prtable">
<thead>
    <tr>
        <th>Product name</th>
        <th>Price</th>
        <th>Image</th>
        <th>Offer</th>
        <th>Options</th>
    </tr>
</thead>
<tbody>
    {{#each products}}
    <tr>
        <td>{{this.title}}</td>
        <td>₹{{this.price}}</td>
        <td><img src='{{this.img_path.[0].url}}' alt="" width="100px" height="100px"></td>
        <td>
          {{#if this.offerstatus}}
            {{#each this.offers}}
              {{#if this.isActive}}
                <span class="badge bg-success">
                  {{#ifCond this.type "percentage"}}{{this.value}}%{{/ifCond}}
                  {{#ifCond this.type "fixed"}}₹{{this.value}}{{/ifCond}}
                  (priority: {{this.priority}})
                </span>
              {{/if}}
            {{/each}}
          {{else}}
            <span class="text-muted">No active offer</span>
          {{/if}}
        </td>
        <td>
          {{#if this.offerstatus}}
            <button class="btn btn-danger" onclick="removeOffer('{{this._id}}')">Remove offer</button>
          {{else}}
            <a href="/admin/add-offer/{{this._id}}" class="btn btn-primary">Add offer</a>
          {{/if}}
        </td>
    </tr>
    {{/each}}
</tbody>
        </table>
    </div>
</div>
</section>

<script>
function removeOffer(id) {
  Swal.fire({
    title: 'Remove offer?',
    text: "Are you sure?",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc2626',
    cancelButtonColor: '#6b7280',
    confirmButtonText: 'Yes, remove it',
  }).then(function(result) {
    if (result.isConfirmed) {
      $.ajax({
        url: '/admin/remove-offer/' + id,
        method: 'delete',
        success: function(response) {
          if (response.success) location.reload();
        }
      });
    }
  });
}
</script>
