<section class="m-0">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6 mt-5 pt-4 shadow-lg p-3 mb-5 bg-body rounded">
        <h3>Add Product Offer</h3>
        <form method="post" action="/admin/add-offer" name="offer-form" id="offer-form">
          <input type="hidden" name="prId" value="{{product._id}}" />

          <div class="mb-3">
            <label class="form-label">Product</label>
            <input type="text" value="{{product.title}}" disabled class="form-control" />
          </div>

          <div class="mb-3">
            <label class="form-label">Offer Type</label>
            <select name="type" class="form-select" required>
              <option value="percentage">Percentage (%)</option>
              <option value="fixed">Fixed Amount (₹)</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Offer Value</label>
            <input type="number" name="offer" id="offeramount" required class="form-control" onkeyup="validateOffer()" />
            <span id="offer-error" class="text-danger text-center"></span>
          </div>

          <div class="mb-3">
            <label class="form-label">Priority (higher = applied first)</label>
            <input type="number" name="priority" class="form-control" value="0" min="0" />
          </div>

          <div class="mb-3">
            <label class="form-label">Offer End Date</label>
            <input type="date" name="enddate" id="date" class="form-control" required />
            <span id="date-error" class="text-danger text-center"></span>
          </div>

          <button type="submit" class="btn btn-primary" onclick="return validateForm()">Submit</button>
        </form>
      </div>
    </div>
  </div>
</section>
<script src="/javascripts/addProductOffer.js"></script>
