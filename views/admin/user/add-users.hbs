<section class="m-0">
  <div class="container-fluid">
    <div class="row">
      <h3>Add User</h3>
      <div class="col-md-6 m-5 mt-3 p-5 shadow-lg p-4 mb-5 bg-body rounded border border-dark">
        <form method="post" action="/admin/add-users">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="user_name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="user_email" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Mobile</label>
            <input type="text" class="form-control" name="user_mobile" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" name="user_password" required>
          </div>
          <button type="submit" class="btn btn-primary">Submit</button>
          <a href="/admin/view-users" class="btn btn-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</section>
