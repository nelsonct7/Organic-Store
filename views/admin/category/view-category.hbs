<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Categories</h4>
  <a href="/admin/add-category" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 6px 16px; font-size: 0.8125rem; text-decoration: none;">+ Add Category</a>
</div>

{{! Search }}
<form method="GET" action="/admin/view-category" class="mb-3">
  <div class="input-group" style="max-width: 400px;">
    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search categories..." value="{{searchValue}}" style="border: 1px solid #d1d5db; border-radius: 6px 0 0 6px; font-size: 0.8125rem;">
    <input type="hidden" name="sort" value="{{pagination.sort}}">
    <input type="hidden" name="order" value="{{pagination.order}}">
    <input type="hidden" name="page" value="1">
    <button class="btn btn-sm" type="submit" style="background: #16a34a; color: #fff; border: none; border-radius: 0 6px 6px 0; font-size: 0.8125rem; padding: 6px 14px;">
      <i class="fa-solid fa-search"></i>
    </button>
  </div>
</form>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="categorytable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563; width: 60px;">Image</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">
              <a href="?sort=name&order={{#if (eq pagination.sort "name")}}{{#if (eq pagination.order "asc")}}desc{{else}}asc{{/if}}{{else}}asc{{/if}}&search={{searchValue}}" style="color: inherit; text-decoration: none;">
                Category
                {{#if (eq pagination.sort "name")}}
                  <i class="fa-solid fa-sort-{{#if (eq pagination.order "asc")}}up{{else}}down{{/if}}" style="font-size: 0.75rem; margin-left: 4px; color: #16a34a;"></i>
                {{/if}}
              </a>
            </th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Description</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563; width: 140px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each categories}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td class="px-3 py-3">
              <img src="{{this.img_path}}" alt="" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover;">
            </td>
            <td class="px-3 py-3" style="font-weight: 500; color: #1f2937;">
              {{this.name}}
              <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500; font-size: 0.6875rem; padding: 2px 8px; margin-left: 6px;">Parent</span>
            </td>
            <td class="px-3 py-3" style="color: #6b7280; max-width: 250px;">{{this.description}}</td>
            <td class="px-3 py-3">
              <div class="d-flex gap-1">
                <a href="/admin/edit-category/{{this._id}}" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem; text-decoration: none;">Edit</a>
                <button onclick="deleteData('{{this._id}}')" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem;">Delete</button>
              </div>
            </td>
          </tr>
          {{!-- Sub-categories under this parent --}}
          {{#each ../subCategories}}
          {{#if (eq this.parentCategory._id ../this._id)}}
          <tr style="border-bottom: 1px solid #f9fafb; background: #f9fafb;">
            <td class="px-3 py-2" style="padding-left: 48px !important;">
              <img src="{{this.img_path}}" alt="" style="width: 32px; height: 32px; border-radius: 6px; object-fit: cover;">
            </td>
            <td class="px-3 py-2" style="color: #4b5563; font-size: 0.8125rem;">
              <i class="fa-solid fa-arrow-right" style="color: #9ca3af; font-size: 0.625rem; margin-right: 6px;"></i>
              {{this.name}}
              <span class="badge" style="background: #fef3c7; color: #92400e; font-weight: 500; font-size: 0.6875rem; padding: 2px 8px; margin-left: 6px;">Sub</span>
            </td>
            <td class="px-3 py-2" style="color: #9ca3af; font-size: 0.8125rem;">{{this.description}}</td>
            <td class="px-3 py-2">
              <div class="d-flex gap-1">
                <a href="/admin/edit-category/{{this._id}}" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 2px 10px; font-size: 0.75rem; text-decoration: none;">Edit</a>
                <button onclick="deleteData('{{this._id}}')" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; padding: 2px 10px; font-size: 0.75rem;">Delete</button>
              </div>
            </td>
          </tr>
          {{/if}}
          {{/each}}
          {{/each}}

          {{#if (eq categories.length 0)}}
          <tr>
            <td colspan="4" class="text-center py-5" style="color: #9ca3af;">
              <i class="fa-solid fa-folder-open" style="font-size: 2rem; display: block; margin-bottom: 8px;"></i>
              No categories yet. <a href="/admin/add-category" style="color: #16a34a;">Add one</a>
            </td>
          </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination pagination=pagination}}

<script src="/javascripts/viewCategoryAdmin.js"></script>
