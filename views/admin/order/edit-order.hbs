<div class="d-flex align-items-center justify-content-between mb-4">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Edit Order</h4>
  <a href="/admin/view-orders" class="btn btn-sm" style="background: #f3f4f6; color: #4b5563; border: none; border-radius: 6px; padding: 6px 14px; font-size: 0.8125rem; text-decoration: none;">← Back to Orders</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <form action="/admin/update-order" method="post">
      <input type="hidden" name="orderId" value="{{orderDetail._id}}">

      <table class="table mb-0" style="font-size: 0.875rem;">
        <tbody>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Order ID</td>
            <td style="border: none; padding: 12px 0;">
              <input type="text" class="form-control" style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; color: #6b7280; max-width: 320px;" value="{{orderDetail._id}}" disabled>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Customer</td>
            <td style="border: none; padding: 12px 0;">
              <input type="text" class="form-control" style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; color: #1f2937; max-width: 320px;" value="{{orderDetail.user_name}} — {{orderDetail.mobile}}" disabled>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Date</td>
            <td style="border: none; padding: 12px 0;">
              <input type="text" class="form-control" style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; color: #6b7280; max-width: 320px;" value="{{orderDetail.stringDate}}" disabled>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Status</td>
            <td style="border: none; padding: 12px 0;">
              <input type="text" class="form-control" style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; color: #6b7280; max-width: 320px;" value="{{orderDetail.status}}" disabled>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Amount</td>
            <td style="border: none; padding: 12px 0;">
              <input type="text" class="form-control" style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; font-weight: 600; color: #166534; max-width: 320px;" value="₹{{orderDetail.total_amount}}" disabled>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Address</td>
            <td style="border: none; padding: 12px 0;">
              <textarea class="form-control" rows="3" style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; color: #4b5563; max-width: 320px;" disabled>{{orderDetail.address.street}}, {{orderDetail.address.city}}, {{orderDetail.address.state}} - {{orderDetail.address.postalCode}}</textarea>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Products</td>
            <td style="border: none; padding: 12px 0;">
              <div style="max-width: 320px;">
                {{#each orderDetail.products}}
                <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #f3f4f6; font-size: 0.875rem; color: #4b5563;">
                  <span>{{this.title}} <span style="color: #9ca3af;">x{{this.quantity}}</span></span>
                  <span style="font-weight: 500;">₹{{this.offPrice}}</span>
                </div>
                {{/each}}
              </div>
            </td>
          </tr>
          <tr>
            <td style="width: 160px; font-weight: 600; color: #4b5563; border: none; padding: 12px 0;">Delivery</td>
            <td style="border: none; padding: 12px 0;">
              {{#if (eq orderDetail.status "delivered")}}
              <input type="text" class="form-control" style="background: #dcfce7; border: 1px solid #86efac; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; color: #166534; font-weight: 500; max-width: 320px;" value="Delivered" disabled>
              {{else if orderDetail.dispatched}}
              <input type="hidden" name="dispatched" value="true">
              <select name="delivered" class="form-select" style="border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; max-width: 320px;">
                <option value="false" selected>Shipped — out for delivery</option>
                <option value="true">Mark as Delivered</option>
              </select>
              {{else}}
              <select name="dispatched" class="form-select" style="border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; font-size: 0.875rem; max-width: 320px;">
                <option value="false" selected>Pending / Processing</option>
                <option value="true">Mark as Shipped</option>
              </select>
              {{/if}}
            </td>
          </tr>
        </tbody>
      </table>

      <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid #f3f4f6;">
        {{#unless (eq orderDetail.status "delivered")}}
        <button type="submit" class="btn" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 8px 20px; font-size: 0.875rem; font-weight: 500;">Update Order</button>
        {{/unless}}
        <a href="/admin/view-orders" class="btn" style="background: #f3f4f6; color: #4b5563; border: none; border-radius: 6px; padding: 8px 20px; font-size: 0.875rem; text-decoration: none;">Cancel</a>
      </div>
    </form>
  </div>
</div>
