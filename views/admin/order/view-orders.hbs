<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Orders</h4>
  <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500;">{{pagination.total}} total</span>
</div>

<form method="GET" action="/admin/view-orders" class="mb-3">
  <div class="input-group" style="max-width: 400px;">
    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by status or payment..." value="{{searchValue}}" style="border: 1px solid #d1d5db; border-radius: 6px 0 0 6px; font-size: 0.8125rem;">
    <input type="hidden" name="sort" value="{{pagination.sort}}">
    <input type="hidden" name="order" value="{{pagination.order}}">
    <input type="hidden" name="page" value="1">
    <button class="btn btn-sm" type="submit" style="background: #16a34a; color: #fff; border: none; border-radius: 0 6px 6px 0; font-size: 0.8125rem; padding: 6px 14px;">
      <i class="fa-solid fa-search"></i>
    </button>
  </div>
</form>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="prtable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">
              <a href="?sort=createdAt&order={{#if (eq pagination.sort "createdAt")}}{{#if (eq pagination.order "asc")}}desc{{else}}asc{{/if}}{{else}}desc{{/if}}&search={{searchValue}}" style="color: inherit; text-decoration: none;">
                Date
                {{#if (eq pagination.sort "createdAt")}}
                  <i class="fa-solid fa-sort-{{#if (eq pagination.order "asc")}}up{{else}}down{{/if}}" style="font-size: 0.75rem; margin-left: 4px; color: #16a34a;"></i>
                {{/if}}
              </a>
            </th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Customer</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Address</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Products</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Payment</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Amount</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Status</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td class="px-3 py-3" style="white-space: nowrap; color: #6b7280;">{{this.stringDate}}</td>
            <td class="px-3 py-3">
              <div style="font-weight: 500; color: #1f2937;">{{this.user_name}}</div>
              <div style="font-size: 0.8125rem; color: #9ca3af;">{{this.mobile}}</div>
            </td>
            <td class="px-3 py-3" style="max-width: 200px;">
              <div style="color: #4b5563; line-height: 1.4;">
                {{#if this.address.street}}{{this.address.street}},{{/if}}
                {{#if this.address.city}}{{this.address.city}},{{/if}}
                {{#if this.address.state}}{{this.address.state}}{{/if}}
                {{#if this.address.postalCode}} - {{this.address.postalCode}}{{/if}}
              </div>
            </td>
            <td class="px-3 py-3">
              {{#each this.products}}
              <div style="color: #4b5563; line-height: 1.5;">
                {{this.title}} <span style="color: #9ca3af;">x{{this.quantity}}</span>
              </div>
              {{/each}}
            </td>
            <td class="px-3 py-3">
              <span class="badge" style="{{#if (eq this.payment_option 'cod')}}background: #fef3c7; color: #92400e;{{else}}background: #dbeafe; color: #1e40af;{{/if}} font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">
                {{#if (eq this.payment_option 'cod')}}COD{{else}}Online{{/if}}
              </span>
            </td>
            <td class="px-3 py-3" style="font-weight: 600; color: #1f2937;">₹{{this.total_amount}}</td>
            <td class="px-3 py-3">
              {{#if (eq this.status 'pending')}}
              <span class="badge" style="background: #fef3c7; color: #92400e; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Pending</span>
              {{else if (eq this.status 'processing')}}
              <span class="badge" style="background: #dbeafe; color: #1e40af; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Processing</span>
              {{else if (eq this.status 'shipped')}}
              <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Shipped</span>
              {{else if (eq this.status 'delivered')}}
              <span class="badge" style="background: #16a34a; color: #fff; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Delivered</span>
              {{else if (eq this.status 'cancelled')}}
              <span class="badge" style="background: #fee2e2; color: #dc2626; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Cancelled</span>
              {{else}}
              <span class="badge" style="background: #f3f4f6; color: #6b7280; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">{{this.status}}</span>
              {{/if}}
            </td>
            <td class="px-3 py-3">
              <div class="d-flex gap-1">
                {{#if this.deleted}}
                  <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Edit</button>
                  <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Delete</button>
                {{else if this.dispatched}}
                  <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Edit</button>
                  <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Delete</button>
                {{else if this.canceled}}
                  <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Edit</button>
                  <button class="btn btn-sm" style="background: #f3f4f6; color: #9ca3af; border: none; cursor: not-allowed;" disabled>Delete</button>
                {{else}}
                  <a href="/admin/edit-order/{{this._id}}" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem; text-decoration: none;">Edit</a>
                  <button onclick="deleteData('{{this._id}}')" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem;">Delete</button>
                {{/if}}
              </div>
            </td>
          </tr>
          {{/each}}

          {{#if (eq orders.length 0)}}
          <tr>
            <td colspan="8" class="text-center py-5" style="color: #9ca3af;">
              <i class="fa-solid fa-truck" style="font-size: 2rem; display: block; margin-bottom: 8px;"></i>
              No orders found.
            </td>
          </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination pagination=pagination}}

<script>
  function deleteData(id) {
    Swal.fire({
      title: 'Delete order?',
      text: "This will mark the order as deleted.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#16a34a',
      cancelButtonColor: '#dc2626',
      confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
      if (result.isConfirmed) {
        $.ajax({
          url: "/admin/delete-order/" + id,
          method: 'get',
          success: (response) => {
            if (response.success) location.reload()
          }
        })
      }
    })
  }
</script>
