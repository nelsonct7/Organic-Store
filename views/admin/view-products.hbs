<div class="d-flex align-items-center justify-content-between mb-4">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Products</h4>
  <a href="/admin/add-products" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 6px 16px; font-size: 0.8125rem; text-decoration: none;">+ Add Product</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="prtable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Image</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Title</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Category</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Price</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Stock</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Date</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Status</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td class="px-3 py-3">
              <img src="/product-images/{{this.img_path.[0]}}" alt="" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover;">
            </td>
            <td class="px-3 py-3" style="font-weight: 500; color: #1f2937;">{{this.title}}</td>
            <td class="px-3 py-3" style="color: #6b7280;">{{this.category}}</td>
            <td class="px-3 py-3" style="font-weight: 600; color: #166534;">₹{{this.price}}</td>
            <td class="px-3 py-3" style="color: #4b5563;">{{this.godown-stock}}</td>
            <td class="px-3 py-3" style="color: #9ca3af; white-space: nowrap;">{{this.date}}</td>
            <td class="px-3 py-3">
              {{#if (eq this.status "Active")}}
              <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Active</span>
              {{else}}
              <span class="badge" style="background: #fee2e2; color: #dc2626; font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">Inactive</span>
              {{/if}}
            </td>
            <td class="px-3 py-3">
              <div class="d-flex gap-1">
                <a href="/admin/edit-product/{{this._id}}" class="btn btn-sm" style="background: #16a34a; color: #fff; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem; text-decoration: none;">Edit</a>
                <button onclick="deleteData('{{this._id}}')" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; border: none; border-radius: 6px; padding: 4px 12px; font-size: 0.8125rem;">Delete</button>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="/javascripts/viewProductAdmin.js"></script>
