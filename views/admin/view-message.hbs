<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">User Messages</h4>
  <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500;">{{pagination.total}} total</span>
</div>

<form class="mb-3" method="GET" action="/admin/view-message">
  <div class="input-group" style="max-width: 400px;">
    <input type="text" class="form-control" name="search" placeholder="Search by subject..." value="{{search}}"
      style="border: 1px solid #d1d5db; border-radius: 6px 0 0 6px; font-size: 0.875rem;">
    <button class="btn" type="submit" style="background: #16a34a; color: #fff; border-radius: 0 6px 6px 0;">
      <i class="fas fa-search"></i>
    </button>
  </div>
</form>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="usrtable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">User</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Subject</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Status</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Messages</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Latest</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each data}}
          <tr style="border-bottom: 1px solid #f3f4f6; {{#if (eq this.status "open")}}background: #fffbeb;{{/if}}">
            <td class="px-3 py-3">
              <div style="font-weight: 500; color: #1f2937;">{{this.userId.name}}</div>
              <small style="color: #6b7280;">{{this.userId.email}}<br>{{this.userId.mobile}}</small>
            </td>
            <td class="px-3 py-3" style="color: #4b5563; font-weight: 500;">{{this.subject}}</td>
            <td class="px-3 py-3">
              <span class="badge" style="
                {{#if (eq this.status "open")}}background: #fef3c7; color: #92400e;
                {{else if (eq this.status "replied")}}background: #dcfce7; color: #166534;
                {{else}}background: #e5e7eb; color: #4b5563;{{/if}}
                font-weight: 500; font-size: 0.75rem; padding: 4px 10px;">
                {{this.status}}
              </span>
            </td>
            <td class="px-3 py-3" style="color: #4b5563;">{{this.messages.length}}</td>
            <td class="px-3 py-3" style="color: #9ca3af; font-size: 0.8rem;">
              <time datetime="{{this.updatedAt}}">{{timeAgo this.updatedAt}}</time>
            </td>
            <td class="px-3 py-3">
              <button class="btn btn-sm btn-outline-success me-1" onclick="viewConversation('{{this._id}}')"
                style="border-radius: 6px; font-size: 0.75rem;" title="View & Reply">
                <i class="fas fa-reply"></i> Reply
              </button>
              <button class="btn btn-sm btn-outline-danger" onclick="deleteConversation('{{this._id}}')"
                style="border-radius: 6px; font-size: 0.75rem;" title="Delete">
                <i class="fas fa-trash-alt"></i>
              </button>
            </td>
          </tr>
          {{/each}}

          {{#if (eq data.length 0)}}
          <tr>
            <td colspan="6" class="text-center py-5" style="color: #9ca3af;">
              <i class="fa-solid fa-envelope-open" style="font-size: 2rem; display: block; margin-bottom: 8px;"></i>
              {{#if search}}No messages match "{{search}}".{{else}}No messages yet.{{/if}}
            </td>
          </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination pagination=pagination}}

<!-- Conversation Modal -->
<div class="modal fade" id="conversationModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
        <h6 class="modal-title" style="font-weight: 600; color: #1f2937;" id="modalSubject">Conversation</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="modalBody" style="max-height: 450px; overflow-y: auto; background: #f9fafb;"></div>
      <div class="modal-footer" style="background: #fff; border-top: 1px solid #e5e7eb;">
        <div class="w-100">
          <input type="hidden" id="modalConvId">
          <div class="mb-2">
            <textarea class="form-control" id="modalReply" rows="2" maxlength="2000"
              placeholder="Type your reply..." style="border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.875rem; resize: none;"></textarea>
          </div>
          <div class="d-flex gap-2">
            <button class="btn" onclick="sendReply()" style="background: #16a34a; color: #fff; font-weight: 500; border-radius: 6px;">
              <i class="fas fa-reply me-1"></i> Send Reply
            </button>
            <button class="btn btn-outline-secondary" onclick="closeConversation()" style="border-radius: 6px; font-weight: 500;">
              <i class="fas fa-check me-1"></i> Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
var currentConvId = null;

function viewConversation(id) {
  currentConvId = id;
  $.getJSON('/admin/messages/' + id, function(res) {
    if (!res.status) { alert('Conversation not found'); return; }
    var c = res.conversation;
    $('#modalSubject').text(c.subject + ' — ' + (c.userId.name || 'User'));
    var html = '';
    (c.messages || []).forEach(function(m) {
      var cls = m.sender === 'user' ? 'user' : 'admin';
      var label = m.sender === 'user' ? (c.userId.name || 'User') : 'Admin';
      var time = m.createdAt ? new Date(m.createdAt).toLocaleString() : '';
      html += '<div style="display:flex; ' + (m.sender === 'user' ? '' : 'justify-content: flex-end;') + ' margin-bottom: 12px;">';
      html += '<div style="max-width: 75%; padding: 10px 14px; border-radius: 12px; font-size: 0.875rem; line-height: 1.5; word-wrap: break-word;';
      if (m.sender === 'user') {
        html += ' background: #dcfce7; color: #166534; border-bottom-left-radius: 4px;">';
      } else {
        html += ' background: #16a34a; color: #fff; border-bottom-right-radius: 4px;">';
      }
      html += '<strong style="font-size:0.7rem; display:block; margin-bottom:2px;">' + label + '</strong>';
      html += m.content;
      html += '<div style="font-size:0.65rem; margin-top:4px; opacity:0.7;">' + time + '</div>';
      html += '</div></div>';
    });
    $('#modalBody').html(html);
    $('#modalConvId').val(id);
    $('#modalReply').val('');
    var modal = new bootstrap.Modal(document.getElementById('conversationModal'));
    modal.show();
    $('#modalBody').scrollTop($('#modalBody')[0].scrollHeight);
  });
}

function sendReply() {
  var id = $('#modalConvId').val();
  var content = $('#modalReply').val().trim();
  if (!content) return;
  $.ajax({
    url: '/admin/messages/' + id + '/reply',
    method: 'POST',
    data: { content: content },
    success: function(res) {
      if (res.status) {
        $('#modalReply').val('');
        viewConversation(id);
      }
    },
    error: function() { alert('Failed to send reply.'); }
  });
}

function closeConversation() {
  var id = $('#modalConvId').val();
  Swal.fire({
    title: 'Close this conversation?',
    text: 'The user will no longer be able to reply.',
    icon: 'question',
    showCancelButton: true,
    confirmButtonColor: '#16a34a',
    confirmButtonText: 'Yes, close it'
  }).then(function(r) {
    if (r.isConfirmed) {
      $.ajax({
        url: '/admin/messages/' + id + '/reply',
        method: 'POST',
        data: { content: '[Conversation closed by admin]', status: 'closed' },
        success: function(res) {
          if (res.status) location.reload();
        }
      });
    }
  });
}

function deleteConversation(id) {
  Swal.fire({
    title: 'Delete conversation?',
    text: 'This action cannot be undone.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc2626',
    confirmButtonText: 'Delete'
  }).then(function(r) {
    if (r.isConfirmed) {
      $.ajax({
        url: '/admin/messages/' + id,
        method: 'DELETE',
        success: function(res) {
          if (res.status) location.reload();
        },
        error: function() { alert('Failed to delete.'); }
      });
    }
  });
}
</script>

<style>
#modalBody::-webkit-scrollbar { width: 6px; }
#modalBody::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }
</style>
