<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0" style="font-weight: 600; color: #1f2937;">Users Messages</h4>
  <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 500;">{{pagination.total}} total</span>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="usrtable" style="font-size: 0.875rem;">
        <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
          <tr>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">User Name</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Email</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Mobile</th>
            <th class="py-3 px-3" style="font-weight: 600; color: #4b5563;">Messages</th>
          </tr>
        </thead>
        <tbody>
          {{#each data}}
          <tr style="border-bottom: 1px solid #f3f4f6;">
            <td class="px-3 py-3" style="font-weight: 500; color: #1f2937;">{{this.user_info.user_name}}</td>
            <td class="px-3 py-3" style="color: #6b7280;">{{this.user_info.user_email}}</td>
            <td class="px-3 py-3" style="color: #4b5563;">{{this.user_info.user_mobile}}</td>
            <td class="px-3 py-3">
              {{#each this.userMessage}}
              <div style="color: #4b5563; line-height: 1.5;">{{@index}}: {{this}}</div>
              {{/each}}
            </td>
          </tr>
          {{/each}}

          {{#if (eq data.length 0)}}
          <tr>
            <td colspan="4" class="text-center py-5" style="color: #9ca3af;">
              <i class="fa-solid fa-envelope-open" style="font-size: 2rem; display: block; margin-bottom: 8px;"></i>
              No messages yet.
            </td>
          </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{> pagination pagination=pagination}}
